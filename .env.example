# ─────────────────────────────────────────────────────────────────────────────
# Переменные окружения. Скопируйте в `.env` на сервере и заполните:
#   cp .env.example .env && chmod 600 .env
#
# Файл НЕ должен попадать в git (он в .gitignore) и в образ (Dockerfile
# исключает его через .dockerignore). Секреты генерируются скриптом
# scripts/bootstrap-fresh.sh — вручную их заполнять не нужно.
# ─────────────────────────────────────────────────────────────────────────────

# ── Домен и TLS ──────────────────────────────────────────────────────────────
# Публичный адрес панели. Используется в ссылках, вебхуке MAX и в белом списке CORS.
DOMAIN=
# Почта для уведомлений Let's Encrypt о выпуске и перевыпуске сертификата.
ACME_EMAIL=
WEBSITE_URL=https://${DOMAIN}
# Домен панели в MAX Mini App — должен совпадать с WEBSITE_URL.
MAX_MINIAPP_URL=https://${DOMAIN}
# Часовой пояс: по умолчанию московский, как в настройках панели.
TZ=Europe/Moscow

# ── База данных (PostgreSQL) ─────────────────────────────────────────────────
# Учётные данные пользователя БД. Из них docker-compose сам собирает
# DATABASE_URL для приложения, так что подключение и пароль не разойдутся.
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=
POSTGRES_DB=dispatch
# Строка подключения. Нужна только для запуска вне Docker (локальная
# разработка): в контейнере её формирует docker-compose из POSTGRES_*.
# В пароле спецсимволы (@ / : ? #) нужно заменить на percent-кодирование.
DATABASE_URL=postgres://dispatch:<пароль>@localhost:5432/dispatch

# ── MAX Bot API ──────────────────────────────────────────────────────────────
# Токен бота: business.max.ru → Чат-боты → Настройки.
MAX_BOT_TOKEN=
# Username бота без @ — нужен для deep-link приглашений и в диагностике.
MAX_BOT_USERNAME=
# Секрет вебхука. Генерируется случайно, держится в тайне: MAX присылает его
# в заголовке X-Max-Bot-Api-Secret, и приложение сверяет значение.
# При ротации обязательно переподписаться на вебхук (Настройки → Интеграция с MAX)
# и перезапустить сторож: scripts/max-webhook-guard.sh
MAX_WEBHOOK_SECRET=
# Хост Bot API. Значение по умолчанию — актуальное; botapi.max.ru и
# platform-api.max.ru устарели.
MAX_API_BASE_URL=https://platform-api2.max.ru
# 1 — режим заглушки: исходящие пишутся в bot_outbox, бот не отвечает.
# В продакшене всегда 0.
MAX_STUB=0
# 1 — получать события через long polling. Только для разработки: при активной
# подписке на вебхук MAX не отдаёт события через polling. В продакшене — 0.
MAX_LONG_POLLING=0
# Задержка перед отправкой следующей медиа-картинки в один чат, мс.
MAX_MEDIA_DEBOUNCE_MS=

# ── Планировщик ──────────────────────────────────────────────────────────────
# Секрет внешнего триггера /api/cron/tick. Если не задан, используется
# MAX_WEBHOOK_SECRET. Генерируется случайно.
CRON_SECRET=
# 1 — процесс сам будит себя раз в минуту через публичный адрес. Нужно там,
# где хостинг усыпляет приложение без входящих запросов. На обычном VPS
# планировщик работает встроенным таймером — ставьте 0.
SCHEDULER_SELF_PING=0

# ── Первый администратор ─────────────────────────────────────────────────────
# Телефон цифрами без плюса. При первом запуске создаётся карточка админа —
# иначе в систему невозможно войти (инвайты выдаёт только админ).
SEED_ADMIN_PHONE=
SEED_ADMIN_NAME=Администратор

# ── Режим разработки ─────────────────────────────────────────────────────────
# 1 — код входа показывается в панели. Работает ТОЛЬКО при NODE_ENV != production.
# В продакшене всегда 0.
DEV_LOGIN=0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Белый список источников для API панели через запятую. Если задан — он главный.
# Если пусто, разрешаются WEBSITE_URL и домены max.ru (мини-приложение).
# ALLOWED_ORIGINS=https://<домен>,https://max.ru

# ── Служебное ────────────────────────────────────────────────────────────────
NODE_ENV=production
# Порт веб-панели внутри docker-сети. Наружу смотрит Caddy на 80/443.
PORT=4200
# Размер пула соединений приложения к PostgreSQL.
DATABASE_POOL_MAX=10
