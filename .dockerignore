# Всё, что не нужно для сборки образа.
# Особенно важно: .env с секретами не должен попасть в образ.

.git
.gitignore
.github

# Секреты и локальное окружение
.env
.env.*
!.env.example

# Зависимости — ставятся внутри образа
node_modules
**/node_modules

# Сборка — делается внутри образа
dist
**/dist
.turbo
**/.turbo
*.tsbuildinfo

# Дампы БД и бэкапы
backups
*.sql
*.sql.gz
*.dump

# Документация и скрипты разработки — в образ не нужны
docs
*.md
!README.md

# Редакторы и ОС
.idea
.vscode
.DS_Store
