{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/web/src/api/routes/**/*.ts",
        "packages/web/src/api/index.ts",
        "packages/web/src/web/**/*.tsx",
        "packages/web/src/web/**/*.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 2000
          }
        ]
      }
    },
    {
      "files": ["packages/web/src/web/components/ui/**"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/web/src/web/**/*.tsx", "packages/web/src/web/**/*.ts"],
      "rules": {
        "jsx-a11y/control-has-associated-label": "warn",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/no-autofocus": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/no-noninteractive-element-interactions": "warn",
        "jsx-a11y/prefer-tag-over-role": "warn",
        "react-hooks/exhaustive-deps": "warn",
        "unicorn/prefer-string-starts-ends-with": "warn"
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "packages/web/public/fonts/**"]
}
