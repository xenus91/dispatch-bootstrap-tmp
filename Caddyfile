# Обратный прокси и автоматический TLS.
#
# Домен подставляется из переменной окружения DOMAIN — конкретное значение
# задаётся один раз, в .env на сервере, и в репозиторий не попадает.
#
# Caddy сам выпускает и перевыпускает сертификат (ACME HTTP-01). Нужны:
#   - A-запись домена на IP сервера;
#   - открытые порты 80 (проверка ACME) и 443.
#
# Если сертификат выпускает российский УЦ, раскомментируйте блок tls:
#   tls /certs/<домен>.crt /certs/<домен>.key
#
# ВАЖНО: rate limiting в Caddy из коробки нет (нужен сторонний плагин
# caddy-ratelimit и своя сборка). Ограничение частоты входа кодом уже
# сделано на уровне приложения: не более 5 попыток ввода кода в час и
# блокировка на 15 минут после 5 ошибок. Если клиенту нужен общий лимит
# на уровне прокси — см. docs/DEPLOYMENT.md, раздел «Ограничение частоты».

{
	email {$ACME_EMAIL:admin@example.com}
	# Тестовый ACME-сервер (сертификаты не будут доверенными):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	# Безопасность панели. frame-ancestors разрешает MAX — иначе мини-приложение
	# в мессенджере открывается пустым.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://st.max.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://platform-api2.max.ru; frame-ancestors 'self' https://max.ru https://*.max.ru"
		-Server
	}

	reverse_proxy app:4200 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}

# Редирект www → основной домен
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
